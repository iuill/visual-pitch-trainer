#!/usr/bin/env bash

set -euo pipefail

codex_bin="${HOST_CODEX_BIN:?HOST_CODEX_BIN is not set}"

if [ ! -x "${codex_bin}" ]; then
  printf 'Host Codex binary is not executable: %s\n' "${codex_bin}" >&2
  exit 127
fi

exec "${codex_bin}" \
  -c 'sandbox_mode="danger-full-access"' \
  -c 'approval_policy="never"' \
  "$@"

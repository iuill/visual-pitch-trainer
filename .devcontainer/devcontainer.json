{
  "name": "Visual Pitch Trainer",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "options": ["--platform=linux/amd64"]
  },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "runArgs": ["--platform=linux/amd64"],
  "remoteUser": "node",
  "containerEnv": {
    "GH_CONFIG_DIR": "/home/node/.config/gh",
    "LANG": "ja_JP.UTF-8",
    "LC_ALL": "ja_JP.UTF-8",
    "TZ": "Asia/Tokyo"
  },
  "remoteEnv": {
    "HOST_CODEX_BIN": "${localEnv:HOME}/.codex/packages/standalone/current/bin/codex",
    "LANG": "${containerEnv:LANG}",
    "LC_ALL": "${containerEnv:LC_ALL}",
    "TZ": "${containerEnv:TZ}",
    "BUN_INSTALL": "/home/node/.bun",
    "UV_INSTALL_DIR": "/home/node/.local/bin",
    "PATH": "/workspace/.devcontainer/bin:/home/node/.bun/bin:/home/node/.local/bin:${containerEnv:PATH}"
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "mounts": [
    "source=${localEnv:HOME}/.codex/packages/standalone,target=${localEnv:HOME}/.codex/packages/standalone,type=bind,readonly",
    "source=${localEnv:HOME}/.codex/auth.json,target=/home/node/.codex/auth.json,type=bind",
    "source=${localEnv:HOME}/.config/gh,target=/home/node/.config/gh,type=bind"
  ],
  "initializeCommand": "bash .devcontainer/scripts/ensure-host-codex-install.sh '${localEnv:HOME}/.codex/packages/standalone' && bash .devcontainer/scripts/ensure-host-codex-auth.sh '${localEnv:HOME}/.codex/auth.json' && bash .devcontainer/scripts/ensure-host-gh-config.sh '${localEnv:HOME}/.config/gh'",
  "appPort": ["35173:5173"],
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Static dev server",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Vite dev server (host 35173)",
      "onAutoForward": "ignore"
    }
  },
  "postCreateCommand": "chmod +x .devcontainer/bin/codex .devcontainer/scripts/*.sh && bash .devcontainer/scripts/install-dev-tools.sh",
  "postStartCommand": "bash .devcontainer/scripts/configure-git-safe-directories.sh || true",
  "postAttachCommand": "bash .devcontainer/scripts/configure-git-safe-directories.sh || true",
  "customizations": {
    "vscode": {
      "extensions": [
        "openai.chatgpt",
        "Anthropic.claude-code",
        "mhutchie.git-graph",
        "GitHub.copilot-chat",
        "ms-vscode.live-server"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "liveServer.settings.host": "0.0.0.0"
      }
    }
  }
}
